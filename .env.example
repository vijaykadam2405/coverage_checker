# Optional backend settings. Existing process variables take precedence.
# Prefer the Windows-protected credential helper; never commit a real API key.
# Never put secrets in VITE_* variables.
# CRAWLSCOPE_CORPUS_API_KEY=replace_with_your_private_key_locally
# CRAWLSCOPE_CORPUS_API_URL=https://your-corpus-api.example
CRAWLSCOPE_PORT=8000
# CRAWLSCOPE_DATA_DIR=data
# CRAWLSCOPE_REPORT_DIR=reports
# Never enable private-network targets in production.

# Imported main crawler helpers: local discovery and challenge classification.
CRAWLSCOPE_MAIN_CRAWLER_HELPERS=1
# Optional original browser identity helpers; no solver/account/service starts.
CRAWLSCOPE_MAIN_CRAWLER_STEALTH=0
