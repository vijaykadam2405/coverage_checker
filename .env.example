# Optional backend settings. Existing process variables take precedence.
# Prefer the Windows-protected credential helper; never commit a real API key.
# Never put secrets in VITE_* variables.
CRAWLSCOPE_CORPUS_API_KEY=
CRAWLSCOPE_CORPUS_API_URL=https://187.127.134.12:8445/
# Optional administrator-provided trusted CA PEM; TLS and hostname checks stay on.
# Prefer a valid HTTPS hostname if the server certificate is not valid for its IP.
# CRAWLSCOPE_CORPUS_CA_BUNDLE=data/certificates/corpus-ca.pem
CRAWLSCOPE_PORT=8000
# CRAWLSCOPE_DATA_DIR=data
# CRAWLSCOPE_REPORT_DIR=reports
# Never enable private-network targets in production.

# Imported main crawler helpers: local discovery and challenge classification.
CRAWLSCOPE_MAIN_CRAWLER_HELPERS=1
# Optional original browser identity helpers; no solver/account/service starts.
CRAWLSCOPE_MAIN_CRAWLER_STEALTH=0
# Local browser only; never uses CAMOFOX_URL or the production browser service.
CRAWLSCOPE_BROWSER_ENGINE=camoufox
# Optional additional historical index; Wayback already runs automatically.
# CRAWLSCOPE_COMMONCRAWL_INDEX=CC-MAIN-YYYY-NN
# CRAWLSCOPE_NODE_PATH=C:/Program Files/nodejs/node.exe
